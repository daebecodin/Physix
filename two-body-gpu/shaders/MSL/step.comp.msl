#include <metal_stdlib>
using namespace metal;

struct Body { float4 position_mass; float4 velocity; float4 appearance; };
struct Parameters { float gravity; float dt; uint body_count; uint phase; };

float3 acceleration(uint i, constant Parameters& p, const device Body* input) {
    float3 result = float3(0.0f);
    float3 position = input[i].position_mass.xyz;
    for (uint j = 0; j < p.body_count; ++j) {
        if (j == i) continue;
        float3 delta = input[j].position_mass.xyz - position;
        float r2 = max(dot(delta, delta), 1.0e-8f);
        result += p.gravity * input[j].position_mass.w * delta * rsqrt(r2 * r2 * r2);
    }
    return result;
}

kernel void main0(constant Parameters& p [[buffer(0)]],
                  const device Body* input [[buffer(1)]],
                  device Body* output [[buffer(2)]],
                  uint i [[thread_position_in_grid]]) {
    if (i >= p.body_count) return;
    Body body = input[i];
    float3 a = acceleration(i, p, input);
    if (p.phase == 0) {
        body.velocity.xyz += a * (0.5f * p.dt);
        body.position_mass.xyz += body.velocity.xyz * p.dt;
    } else {
        body.velocity.xyz += a * (0.5f * p.dt);
    }
    output[i] = body;
}
