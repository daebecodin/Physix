#include <metal_stdlib>
using namespace metal;

struct Body { float4 position_mass; float4 velocity; };
struct Parameters { float gravity; float dt; float unused0; float unused1; };

float3 acceleration(float3 position, float3 other, float other_mass, float gravity) {
    float3 delta = other - position;
    float r2 = max(dot(delta, delta), 1.0e-8f);
    return gravity * other_mass * delta * rsqrt(r2 * r2 * r2);
}

kernel void main0(constant Parameters& p [[buffer(0)]],
                  const device Body* input [[buffer(1)]],
                  device Body* output [[buffer(2)]],
                  uint i [[thread_position_in_grid]]) {
    if (i >= 2) return;
    uint j = 1 - i;
    Body a = input[i], b = input[j];
    float3 a0 = acceleration(a.position_mass.xyz, b.position_mass.xyz, b.position_mass.w, p.gravity);
    float3 b0 = acceleration(b.position_mass.xyz, a.position_mass.xyz, a.position_mass.w, p.gravity);
    float3 half_a = a.velocity.xyz + a0 * (0.5f * p.dt);
    float3 half_b = b.velocity.xyz + b0 * (0.5f * p.dt);
    float3 new_a = a.position_mass.xyz + half_a * p.dt;
    float3 new_b = b.position_mass.xyz + half_b * p.dt;
    float3 a1 = acceleration(new_a, new_b, b.position_mass.w, p.gravity);
    a.position_mass.xyz = new_a;
    a.velocity.xyz = half_a + a1 * (0.5f * p.dt);
    output[i] = a;
}
